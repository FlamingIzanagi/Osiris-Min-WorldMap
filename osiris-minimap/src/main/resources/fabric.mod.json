    "osiris-worldmap.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "xaerominimap": ">=26.6.0",
    "xaeroworldmap": ">=1.47.0"
  },
  "suggests": {
    "modmenu": "*"
  }
